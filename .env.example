# Backend Configuration
PORT=8000
MODEL_BACKEND=cloud
OLLAMA_CLOUD_URL=https://ollama.com
MODEL_NAME=gemma4:31b-cloud
OLLAMA_API_KEY=your_ollama_api_key_here
DB_PATH=./data/swasthyasanjaal.db
LEXICON_PATH=./data/nepali_clinical_lexicon.json
BENCHMARK_PATH=./data/nepclinbench.json

# Offline-First Edge Fallback Model (Local Ollama for rural clinics & FCHV use)
OLLAMA_URL=http://localhost:11434
LOCAL_GEMMA_MODEL=gemma4:e2b-it-qat

# Security / session settings
# SESSION_SECRET_KEY: Required in production (when SESSION_COOKIE_SECURE=true).
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Do NOT commit this value to version control.
SESSION_SECRET_KEY=your_session_secret_key_here

# Session cookie security. Set SESSION_COOKIE_SECURE=true in production (HTTPS).
# For local development, leave as false (HTTP).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=3600

# Rate limiting
MAX_FAILED_LOGIN_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_SECONDS=900
